# ---- Database ----
DATABASE_URL=sqlite:///./tryonix.db

# ---- Storage ----
STORAGE_MODE=local
STORAGE_DIR=./storage

# ---- AI Try-On Provider ----
# Options: fashn, mock
TRYON_PROVIDER=fashn

# FASHN.ai API (server-side only — NEVER expose to the browser)
# Get a key at https://app.fashn.ai/api (requires credits)
FASHN_API_KEY=
FASHN_API_URL=https://api.fashn.ai

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend (exposed to browser)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# FASHN.ai Virtual Try-On API
# Required for the try-on feature to work.
# 1. Create an account at https://app.fashn.ai
# 2. Purchase API credits at https://app.fashn.ai/billing
# 3. Generate an API key at https://app.fashn.ai/api
# 4. Paste the key below
VITE_FASHN_API_KEY=your_fashn_api_key
VITE_FASHN_API_URL=https://api.fashn.ai

# Backend only — NEVER expose these to the frontend
# In production, proxy FASHN calls through a backend so the key
# stays server-side. The VirtualTryOnProvider interface stays
# the same — only the provider implementation changes.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# FASHN_API_KEY=your_fashn_api_key (server-side only in production)
# STORAGE_ENDPOINT=https://your-r2-endpoint
# STORAGE_ACCESS_KEY_ID=your_access_key
# STORAGE_SECRET_ACCESS_KEY=your_secret_key
# STORAGE_BUCKET=tryonix
# JWT_SECRET=your_jwt_secret
